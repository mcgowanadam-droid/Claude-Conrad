{
  "name": "AI Analysis Calculator -> Create GHL Contact",
  "nodes": [
    {
      "id": "webhook-trigger",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [250, 300],
      "webhookId": "ai-analysis-calculator",
      "parameters": {
        "path": "ai-analysis-calculator",
        "httpMethod": "POST",
        "responseMode": "responseNode",
        "options": {}
      }
    },
    {
      "id": "send-confirmation-text",
      "name": "Send Confirmation Text",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300],
      "parameters": {
        "method": "POST",
        "url": "https://services.leadconnectorhq.com/conversations/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Version",
              "value": "2021-07-28"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ type: \"SMS\", contactId: $json.body.contactId || $json.body.contact_id, message: \"Thank you for submitting your analysis request! We have received your information and are processing your results. You will receive your AI analysis shortly. Reply STOP to unsubscribe.\" }) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "GHL_API_CREDENTIAL_ID",
          "name": "GHL API Key"
        }
      }
    },
    {
      "id": "ai-analysis-calculator",
      "name": "AI Analysis Calculator",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [710, 300],
      "parameters": {
        "jsCode": "// AI Analysis Calculator logic\n// Process the incoming webhook data and compute analysis results\nconst inputData = $input.all();\n\nconst results = inputData.map(item => {\n  const data = item.json.body || item.json;\n  return {\n    json: {\n      ...data,\n      analysisComplete: true,\n      processedAt: new Date().toISOString()\n    }\n  };\n});\n\nreturn results;"
      }
    },
    {
      "id": "create-ghl-contact",
      "name": "Create GHL Contact",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [940, 300],
      "parameters": {
        "method": "POST",
        "url": "https://services.leadconnectorhq.com/contacts/",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Version",
              "value": "2021-07-28"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ firstName: $json.firstName || $json.first_name, lastName: $json.lastName || $json.last_name, email: $json.email, phone: $json.phone, source: \"AI Analysis Calculator\", tags: [\"ai-analysis\", \"calculator-lead\"] }) }}",
        "options": {}
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "GHL_API_CREDENTIAL_ID",
          "name": "GHL API Key"
        }
      }
    },
    {
      "id": "respond-to-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1170, 300],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { success: true, message: \"Contact created and confirmation text sent\", contactId: $json.contact?.id || $json.id } }}",
        "options": {
          "responseCode": 200
        }
      }
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Send Confirmation Text",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Confirmation Text": {
      "main": [
        [
          {
            "node": "AI Analysis Calculator",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "AI Analysis Calculator": {
      "main": [
        [
          {
            "node": "Create GHL Contact",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create GHL Contact": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [],
  "triggerCount": 0,
  "active": false
}
